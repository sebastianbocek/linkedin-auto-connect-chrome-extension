{
  "manifest_version": 3,
  "name": "LinkedIn auto-connect chrome extension",
  "short_name": "LinkedIn Auto-Connect",
  "version": "2.1.0",
  "description": "Filtra perfiles de LinkedIn con keywords configurables, conecta hasta el límite y exporta perfiles seleccionados a CSV.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "LinkedIn Auto-Connect",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png"
    },
    "default_popup": "popup.html"
  }
}
